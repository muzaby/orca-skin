{
  "name": "orca",
  "version": "0.3.1",
  "description": "Orca — desktop LLM chat app for verification engineers",
  "main": "./out/main/index.js",
  "author": "muzaby",
  "homepage": "https://github.com/muzaby/orca-skin",
  "scripts": {
    "format": "prettier --write ./src",
    "lint": "eslint --cache --fix ./src ./scripts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/ensure-sqlite-abi.mjs electron",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "analyze:composer-input-trace": "node scripts/analyze-composer-input-trace.mjs",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "node scripts/ensure-sqlite-abi.mjs node",
    "predev": "node scripts/ensure-sqlite-abi.mjs electron",
    "prebuild": "node scripts/ensure-sqlite-abi.mjs electron",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-virtual": "^3.14.6",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.29.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "i18next": "^26.3.6",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^17.0.9",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "undici": "^8.3.0",
    "vite": "^7.2.6",
    "vitest": "^4.1.7"
  }
}
